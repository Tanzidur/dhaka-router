# Copy this file to .env and add your key. The app also runs without one.
#
# One key for everything (simplest for local use):
GOOGLE_MAPS_API_KEY=

# Or use two keys, which is safer if you ever host this publicly:
# GOOGLE_MAPS_BROWSER_KEY=   restricted by HTTP referrer, Maps JavaScript API only
# GOOGLE_MAPS_SERVER_KEY=    restricted by IP, Routes API and Places API (New)
